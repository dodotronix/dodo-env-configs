#!/usr/bin/env bash
# Run Claude Code in docker as a named agent.
#
#   claude_agent <name> [path[:dest[:ro]] ...]
#
# Every agent has its own folder $CLAUDE_AGENTS_DIR/<name>/ with
#   claude/  -> mounted as the container's CLAUDE_CONFIG_DIR (login, history, memory)
#   mounts   -> the mounts it was last started with
# A plain path is mounted to /home/ubuntu/projects/<basename>, "path:dest[:ro]"
# is passed to docker -v as is. Without paths the saved mounts are reused.

set -euo pipefail

AGENTS_DIR=${CLAUDE_AGENTS_DIR:-$HOME/claude-agents}
IMAGE=${CLAUDE_IMAGE:-claude-code}
CTR_HOME=/home/ubuntu

usage() {
    printf 'usage: %s <name> [path[:dest[:ro]] ...]\n' "${0##*/}" >&2
    printf 'agents in %s:\n' "$AGENTS_DIR" >&2
    ls "$AGENTS_DIR" 2> /dev/null | sed 's/^/  /' >&2
    exit 1
}

[ $# -ge 1 ] || usage
name=$1; shift
[[ $name =~ ^[A-Za-z0-9_.-]+$ ]] || usage

agent_dir=$AGENTS_DIR/$name
mounts_file=$agent_dir/mounts
mkdir -p "$agent_dir/claude"

# new mounts given -> resolve to absolute paths and remember them
if [ $# -gt 0 ]; then
    specs=()
    for m in "$@"; do
        src=${m%%:*}
        rest=; [[ $m == *:* ]] && rest=:${m#*:}
        src=$(realpath -e -- "$src") || { printf 'ERR: %s does not exist\n' "$m" >&2; exit 1; }
        [ -n "$rest" ] || rest=:$CTR_HOME/projects/$(basename "$src")
        specs+=("$src$rest")
    done
    printf '%s\n' "${specs[@]}" > "$mounts_file"
elif [ -f "$mounts_file" ]; then
    mapfile -t specs < "$mounts_file"
else
    specs=()
fi

args=(-v "$agent_dir/claude:$CTR_HOME/claude")
for s in "${specs[@]}"; do
    printf '[INF]: mount %s\n' "$s"
    args+=(-v "$s")
done

# not in the docker group -> go through sudo
docker=(docker); docker info &> /dev/null || docker=(sudo docker)

if "${docker[@]}" container inspect "claude-$name" &> /dev/null; then
    printf 'ERR: agent "%s" is already running (docker stop claude-%s)\n' "$name" "$name" >&2
    exit 1
fi

exec "${docker[@]}" run --rm -it --name "claude-$name" --hostname "$name" \
    -w "$CTR_HOME/projects" "${args[@]}" "$IMAGE" claude
