From 2f1818fdedef151a611716dd99369ea4aa0c4221 Mon Sep 17 00:00:00 2001
From: me <me@local>
Date: Tue, 20 Oct 2026 13:26:53 +0000
Subject: [PATCH 1/2] Strip the number of workspace 0 too

---
 panel-plugin/i3w-plugin.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/panel-plugin/i3w-plugin.c b/panel-plugin/i3w-plugin.c
index c321ad8..8e58cd2 100644
--- a/panel-plugin/i3w-plugin.c
+++ b/panel-plugin/i3w-plugin.c
@@ -552,7 +552,7 @@ set_button_label(GtkWidget *button, i3workspace *workspace,
     if (workspace->visible) gtk_style_context_add_class(context, "visible");
     else gtk_style_context_remove_class(context, "visible");
 
-    gchar *name = (config->strip_workspace_numbers && workspace->num > 0) ?
+    gchar *name = (config->strip_workspace_numbers && workspace->num >= 0) ?
         strip_workspace_numbers(workspace->name, workspace->num) :
         workspace->name;
 
